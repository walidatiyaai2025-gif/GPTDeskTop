<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>GPTDeskTop-Setup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>MsiPath=$(MSBuildProjectDirectory)\..\GPTDeskTop.Setup\bin\$(Configuration)\GPTDeskTop.msi</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GPTDeskTop.Setup\GPTDeskTop.Setup.wixproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="WixToolset.Bal.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
