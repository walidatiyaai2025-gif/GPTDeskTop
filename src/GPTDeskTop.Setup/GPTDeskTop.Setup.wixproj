<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>GPTDeskTop</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>PayloadDir=$(MSBuildProjectDirectory)\Payload</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GPTDeskTop\GPTDeskTop.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="PublishApplication" BeforeTargets="BeforeBuild">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\Payload" Condition="Exists('$(MSBuildProjectDirectory)\Payload')" />
    <MSBuild Projects="..\GPTDeskTop\GPTDeskTop.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=false;PublishDir=$(MSBuildProjectDirectory)\Payload\" />
  </Target>
</Project>
