{
  "Chrome": {
    "DebuggingBaseUrl": "http://127.0.0.1:9222",
    "DebuggingPort": 9222,
    "StartUrl": "https://chatgpt.com/"
  },
  "Monitoring": {
    "PollIntervalMilliseconds": 1000,
    "StableResponseMilliseconds": 1500,
    "DelayAfterSendMilliseconds": 1200
  },
  "Database": {
    "FileName": "appdata.db"
  },
  "TaskAutomation": {
    "Enabled": true,
    "WorkWindowMinutes": 10,
    "CoolingWindowMinutes": 5,
    "ResumeOnStartup": true,
    "PersistCheckpoints": true,
    "MessageCatalogFile": "task-messages.json"
  }
}
